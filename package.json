{
  "name": "procmix",
  "private": true,
  "version": "0.5.1",
  "description": "ProcMix - cross-platform automation tool",
  "productName": "ProcMix",
  "author": "Zenkin Egor Andreevich",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "tauri": "tauri",
    "tauri:dev": "cross-env PROCMIX_DEV_LICENSE=pro tauri dev --config src-tauri/tauri.conf.dev.json",
    "tauri:dev-basic": "cross-env PROCMIX_DEV_LICENSE=basic tauri dev --config src-tauri/tauri.conf.dev.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.15",
    "@dnd-kit/sortable": "^10.0.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.1.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.8",
    "reactflow": "^11.11.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.8",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.7",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.7"
  }
}
