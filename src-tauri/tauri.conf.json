{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProcMix",
  "version": "0.13.2",
  "identifier": "app.procmix.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1520",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ProcMix",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "theme": null,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://license.procmix.app https://github.com https://objects.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "publisher": "ProcMix",
    "homepage": "https://procmix.app",
    "copyright": "Copyright © 2026 ProcMix",
    "shortDescription": "Visual automation tool for power users",
    "longDescription": "ProcMix is a cross-platform automation tool with a drag-and-drop visual editor for building custom command workflows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "sounds/*.wav"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": true
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5NkY5QTVFMzQwMzk5NzgKUldSNG1RTTBYcHB2S1M0cURVd2toaEl5OUROanlkRnZaNHc2UU1uZ0NPUUFpMk9zL2k0S0NEZkQK",
      "endpoints": [
        "https://github.com/ez404-36/proc_mix_app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}